# Test Environment Variables
# Copy this file to .env.test and update values for your test environment

NODE_ENV=test

# Database Configuration (use test database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisions_test

# Claude API (will be mocked in tests)
ANTHROPIC_API_KEY=test-api-key-not-used

# JWT Secret (use test secret)
JWT_SECRET=test-secret-for-jest

# Logging (reduce noise during tests)
LOG_LEVEL=error
DEBUG_TESTS=false

# Optional: Test timeout (milliseconds)
TEST_TIMEOUT=10000
